# TaxFlow.AI Backend Environment Configuration
# Copy this file to .env and fill in your actual values

# Server Configuration
PORT=5000
NODE_ENV=development

# ─────────────────────────────────────────────────────────────
# SUPABASE DATABASE AND PRIVATE TELEGRAM DOCUMENT STORAGE
# Get these from: https://supabase.com -> Project -> Settings -> API
# ─────────────────────────────────────────────────────────────
SUPABASE_URL=https://YOUR_PROJECT_ID.supabase.co
# Server-only Supabase secret key (new API key format)
SUPABASE_SECRET_KEY=sb_secret_your_key_here
# Legacy fallback; use SUPABASE_SECRET_KEY for new deployments.
SUPABASE_SERVICE_ROLE_KEY=your_service_role_key_here
SUPABASE_ANON_KEY=your_anon_key_here
SUPABASE_STORAGE_BUCKET=taxflow-intake
DATABASE_URL=your_supabase_postgres_connection_string

# Public website origin used for Supabase client-portal invitation redirects.
CLIENT_PORTAL_URL=https://your-website.example
# Public web page used by Supabase Auth recovery links. Keep the desktop deep link as a fallback only.
PASSWORD_RESET_REDIRECT_URL=https://taxflowaiwebsite.vercel.app/reset-password

# ─────────────────────────────────────────────────────────────
# LEGACY VAULT SOURCE FOR THE ONE-TIME CLOUD MIGRATION ONLY
# Set this only when running the one-time local-to-cloud migration script.
# ─────────────────────────────────────────────────────────────
VAULT_PATH=C:\TaxFlowVault

# ─────────────────────────────────────────────────────────────
# GOOGLE GEMINI AI API
# Get your key from: https://aistudio.google.com/app/apikey
# ─────────────────────────────────────────────────────────────
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ─────────────────────────────────────────────────────────────
# WHATSAPP CLOUD API (Meta Business Platform)
# Get these from: https://developers.facebook.com
# ─────────────────────────────────────────────────────────────
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id
WHATSAPP_ACCESS_TOKEN=your_whatsapp_access_token
WHATSAPP_VERIFY_TOKEN=your_long_random_webhook_verification_token
WHATSAPP_APP_SECRET=your_meta_app_secret

# TELEGRAM BOT API
TELEGRAM_BOT_TOKEN=your_telegram_bot_token
TELEGRAM_BOT_USERNAME=your_bot_username_without_at
TELEGRAM_WEBHOOK_SECRET=your_high_entropy_webhook_secret
TELEGRAM_WEBHOOK_AUTO_CONFIGURE=false
PUBLIC_URL=https://your-public-backend-host
# Set this on the TaxFlow backend when the separate Telegram Render service owns the webhook.
TELEGRAM_WEBHOOK_RELAY_URL=https://your-telegram-relay.onrender.com/telegram/webhook

# RESEND EMAIL NOTIFICATIONS & INVITATIONS
# API Key from Resend: https://resend.com/api-keys
RESEND_API_KEY=your_resend_api_key_here
# Sender email address (e.g., TaxFlow.AI <onboarding@resend.dev> or your verified domain)
RESEND_FROM_EMAIL=TaxFlow.AI <onboarding@resend.dev>
